#include <stdio.h>

int main() {
    char str1[100], str2[100];
    int i = 0, j = 0;

    // Input strings
    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    // Move to the end of first string
    while(str1[i] != '\0') {
        i++;
    }

    // Append second string to first string
    while(str2[j] != '\0') {
        str1[i] = str2[j];
        i++;
        j++;
    }

    // Add null character at the end
    str1[i] = '\0';

    // Output result
    printf("Concatenated string = %s\n", str1);

    return 0;
}
