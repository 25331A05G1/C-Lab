#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], str3[200];
    int length, result;

    // Input strings
    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    // String Copy
    strcpy(str3, str1);
    printf("\nAfter copying, str3 = %s", str3);

    // String Concatenation
    strcat(str1, str2);
    printf("\nAfter concatenation, str1 = %s", str1);

    // String Length
    length = strlen(str2);
    printf("\nLength of second string = %d", length);

    // String Comparison
    result = strcmp(str2, str3);

    if(result == 0)
        printf("\nStrings are equal");
    else if(result > 0)
        printf("\nSecond string is greater than copied string");
    else
        printf("\nSecond string is smaller than copied string");

    return 0;
}
   
