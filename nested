#include <stdio.h>

// Inner structure
struct Date {
    int day;
    int month;
    int year;
};

// Outer structure (contains another structure)
struct Student {
    int rollNo;
    char name[50];
    struct Date dob;  // Nested structure
};

int main() {
    // Declare structure variable
    struct Student s1;

    // Assign values
    s1.rollNo = 102;
    sprintf(s1.name, "Anil");

    // Assign values to nested structure members
    s1.dob.day = 15;
    s1.dob.month = 8;
    s1.dob.year = 2005;

    // Display values
    printf("Student Details:\n");
    printf("Roll Number: %d\n", s1.rollNo);
    printf("Name: %s\n", s1.name);
    printf("Date of Birth: %d/%d/%d\n",
           s1.dob.day, s1.dob.month, s1.dob.year);

    return 0;
}
